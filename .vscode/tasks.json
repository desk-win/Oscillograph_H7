{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CM7",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C", "${workspaceFolder}\\CM7\\build"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Build CM4",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C", "${workspaceFolder}\\CM4\\build"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "CubeProgrammer: Flash",
            "type": "shell",
            "command": "C:\\Users\\chair\\AppData\\Local\\stm32cube\\bundles\\programmer\\2.22.0+st.1\\bin\\STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD",
                "-w", "${workspaceFolder}\\CM7\\build\\Oscillograph_H7_CM7.elf",
                "-w", "${workspaceFolder}\\CM4\\build\\Oscillograph_H7_CM4.elf",
                "-rst"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Build CM7", "Build CM4"],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
