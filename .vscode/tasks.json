{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build CM7",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C", "${workspaceFolder}\\CM7\\build"
            ],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Build CM4",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C", "${workspaceFolder}\\CM4\\build"
            ],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Build BootLoader",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}\\BootLoader\\build\\Debug",
                "--parallel", "4"
            ],
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
        {
            "label": "Flash BootLoader",
            "type": "shell",
            "command": "C:\\Users\\chair\\AppData\\Local\\stm32cube\\bundles\\programmer\\2.22.0+st.1\\bin\\STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD",
                "-w", "${workspaceFolder}\\BootLoader\\CM7\\build\\BootLoader_CM7.elf",
                "-rst"
            ],
            "group": {
                "kind": "build"
            },
            "dependsOn": ["Build BootLoader"],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Flash Oscillograph_H7",
            "type": "shell",
            "command": "C:\\Users\\chair\\AppData\\Local\\stm32cube\\bundles\\programmer\\2.22.0+st.1\\bin\\STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD",
                "-w", "${workspaceFolder}\\CM7\\build\\Oscillograph_H7_CM7.elf",
                "-w", "${workspaceFolder}\\CM4\\build\\Oscillograph_H7_CM4.elf",
                "-rst"
            ],
            "group": {
                "kind": "build"
            },
            "dependsOn": ["Build CM7", "Build CM4"],
            "dependsOrder": "sequence",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "problemMatcher": []
        }
    ]
}
